{
  "name": "the-shelf",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "export:content": "py -X utf8 scripts/export_content.py",
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/release-gate.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-dist.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check:gate": "node scripts/release-gate.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node scripts/release-gate.mjs --selftest && node scripts/check-links.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "gsap": "3.15.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
