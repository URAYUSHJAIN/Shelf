 .lt-lid {\r\n  transition: none;\r\n}\r\n.lt-shadow,\r\n.lt-base,\r\n.lt-lid,\r\n.lt-deck,\r\n.lt-front,\r\n.lt-side,\r\n.lt-hinge,\r\n.lt-outer,\r\n.lt-inner,\r\n.lt-edge {\r\n  position: absolute;\r\n}\r\n\r\n/* Contact shadow on the desk, offset away from the lamp (upper right). */\r\n.lt-shadow {\r\n  inset: -2% -3% -4% -4%;\r\n  border-radius: 6%;\r\n  background:\r\n    radial-gradient(ellipse 50% 50% at 48% 54%, rgba(48, 28, 10, 0.36), rgba(48, 28, 10, 0.14) 66%, transparent 78%),\r\n    linear-gradient(to top, transparent 2%, rgba(40, 22, 6, 0.28) 4.5%, transparent 9%);\r\n  transition: opacity 420ms var(--ease-out);\r\n}\r\n\r\n/* ---------- Base ---------- */\r\n.lt-base {\r\n  inset: 0;\r\n  transform-style: preserve-3d;\r\n  transform: translateZ(var(--foot));\r\n}\r\n.lt-deck {\r\n  inset: 0;\r\n  overflow: hidden;\r\n  border-radius: calc(var(--lw) * 0.022);\r\n  transform: translateZ(var(--bt));\r\n  pointer-events: auto;\r\n  background:\r\n    radial-gradient(ellipse 60% 70% at 72% 10%, rgba(255, 246, 228, 0.5), transparent 70%),\r\n    linear-gradient(176deg, #dcdee2 0%, #c9ccd1 48%, #b9bdc3 100%);\r\n  box-shadow:\r\n    inset 0 0 0 calc(var(--lw) * 0.0018) rgba(255, 255, 255, 0.75),\r\n    inset 0 calc(var(--lw) * -0.004) calc(var(--lw) * 0.006) rgba(80, 84, 92, 0.25);\r\n}\r\n/* Under a closed or peeking lid the deck sits in the lid's shadow; it clears as the lid opens. */\r\n.lt-deck::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 2;\r\n  pointer-events: none;\r\n  background: linear-gradient(rgba(14, 14, 18, 0.9), rgba(28, 28, 34, 0.62));\r\n  transition: opacity var(--lid-ms) ease-out;\r\n}\r\n.laptop[data-lid='open'] .lt-deck::after {\r\n  opacity: 0;\r\n}\r\n.lt-front {\r\n  left: 0;\r\n  top: 100%;\r\n  width: 100%;\r\n  height: var(--bt);\r\n  transform-origin: 50% 0;\r\n  transform: translateZ(var(--bt)) rotateX(-90deg);\r\n  border-radius: 0 0 calc(var(--lw) * 0.02) calc(var(--lw) * 0.02);\r\n  background: linear-gradient(#e7e8eb 0%, #b4b7bd 30%, #8c9097 100%);\r\n  box-shadow:\r\n    inset 0 calc(var(--lw) * 0.0015) 0 rgba(255, 255, 255, 0.9),\r\n    0 0 0 calc(var(--lw) * 0.0016) rgba(42, 31, 22, 0.5);\r\n}\r\n/* Thumb scoop and rubber feet. */\r\n.lt-front::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: 43%;\r\n  width: 14%;\r\n  top: 0;\r\n  height: 46%;\r\n  border-radius: 0 0 calc(var(--lw) * 0.01) calc(var(--lw) * 0.01);\r\n  background: linear-gradient(#80848b, #a9adb3);\r\n}\r\n.lt-front::after {\r\n  content: '';\r\n  position: absolute;\r\n  left: 6%;\r\n  right: 6%;\r\n  bottom: -26%;\r\n  height: 30%;\r\n  background:\r\n    radial-gradient(ellipse at 4% 50%, #2a2a2d 0 45%, transparent 50%) 0 0 / 50% 100% no-repeat,\r\n    radial-gradient(ellipse at 96% 50%, #2a2a2d 0 45%, transparent 50%) 100% 0 / 50% 100% no-repeat;\r\n}\r\n.lt-side {\r\n  top: 0;\r\n  width: var(--bt);\r\n  height: 100%;\r\n  background: linear-gradient(90deg, #8e9298, #c2c5ca);\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n  gap: 3%;\r\n  padding-top: 16%;\r\n}\r\n.lt-side--l {\r\n  left: 0;\r\n  transform-origin: 0 50%;\r\n  transform: rotateY(-90deg);\r\n}\r\n.lt-side--r {\r\n  right: 0;\r\n  transform-origin: 100% 50%;\r\n  transform: rotateY(90deg);\r\n}\r\n.lt-side i {\r\n  width: 34%;\r\n  height: 4.5%;\r\n  border-radius: calc(var(--lw) * 0.004);\r\n  background: #26272a;\r\n  box-shadow: 0 0 0 calc(var(--lw) * 0.0008) #6f737a;\r\n}\r\n.lt-side i.lt-port--mag {\r\n  height: 7%;\r\n  width: 26%;\r\n}\r\n.lt-side i.lt-port--jack {\r\n  width: 34%;\r\n  height: 2.6%;\r\n  border-radius: 50%;\r\n}\r\n.lt-hinge {\r\n  left: 9%;\r\n  width: 82%;\r\n  bottom: 100%;\r\n  height: calc(var(--lt) + var(--gap) * 2);\r\n  transform-origin: 50% 100%;\r\n  transform: translateZ(var(--bt)) rotateX(-90deg);\r\n  border-radius: calc(var(--lw) * 0.006);\r\n  background: linear-gradient(#2c2d31, #55585e 45%, #1e1f22);\r\n}\r\n\r\n/* Speaker grilles, keyboard and trackpad sit flat in the deck plane. */\r\n.lt-grille {\r\n  position: absolute;\r\n  top: 5%;\r\n  height: 49%;\r\n  width: 4.2%;\r\n  background: radial-gradient(circle, #6d7178 0 32%, transparent 38%) 0 0 / calc(var(--lw) * 0.006) calc(var(--lw) * 0.006);\r\n  opacity: 0.75;\r\n}\r\n.lt-grille--l { left: 1.6%; }\r\n.lt-grille--r { right: 1.6%; }\r\n\r\n.lt-keys {\r\n  position: absolute;\r\n  left: 7%;\r\n  right: 7%;\r\n  top: 4.5%;\r\n  height: 50%;\r\n  display: grid;\r\n  grid-template-columns: repeat(58, minmax(0, 1fr));\r\n  grid-template-rows: 0.6fr repeat(5, 1fr);\r\n  padding: calc(var(--lw) * 0.003);\r\n  border-radius: calc(var(--lw) * 0.008);\r\n  background:\r\n    radial-gradient(ellipse 70% 60% at 50% 50%, rgba(255, 214, 150, calc(var(--bl) * 0.32)), transparent 80%),\r\n    #17181a;\r\n  box-shadow:\r\n    inset 0 calc(var(--lw) * 0.002) calc(var(--lw) * 0.004) rgba(0, 0, 0, 0.7),\r\n    0 0 0 calc(var(--lw) * 0.0012) rgba(255, 255, 255, 0.55);\r\n}\r\n.key-stack {\r\n  grid-column: span var(--span);\r\n  display: grid;\r\n  grid-template-rows: 1fr 1fr;\r\n  min-width: 0;\r\n}\r\n.key {\r\n  grid-column: span var(--span);\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4%;\r\n  min-width: 0;\r\n  margin: calc(var(--lw) * 0.0021);\r\n  border-radius: calc(var(--lw) * 0.0042);\r\n  background: linear-gradient(#2e2f33, #1f2023);\r\n  box-shadow:\r\n    inset 0 calc(var(--lw) * 0.0012) 0 rgba(255, 255, 255, 0.13),\r\n    0 calc(var(--lw) * 0.0016) 0 #08080a,\r\n    0 calc(var(--lw) * 0.003) calc(var(--lw) * 0.003) rgba(0, 0, 0, 0.4);\r\n  color: color-mix(in srgb, #fff1d6 calc(var(--bl) * 100%), #c9cbd0);\r\n  text-shadow: 0 0 calc(var(--lw) * 0.006) rgba(255, 220, 160, calc(var(--bl) * 0.9));\r\n  font: 500 calc(var(--lw) * 0.0118) / 1 var(--sans);\r\n  white-space: nowrap;\r\n  user-select: none;\r\n  -webkit