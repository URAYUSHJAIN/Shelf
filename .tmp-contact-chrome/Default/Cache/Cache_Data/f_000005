a;\r\n}\r\n.key[aria-pressed='true'] {\r\n  color: #fff1d6;\r\n}\r\n.key:focus-visible {\r\n  outline: calc(max(2px, var(--lw) * 0.0035)) solid #8fb0ff;\r\n  outline-offset: 1px;\r\n  z-index: 1;\r\n}\r\n\r\n.lt-trackpad {\r\n  position: absolute;\r\n  left: 29%;\r\n  width: 42%;\r\n  top: 59%;\r\n  height: 36%;\r\n  border-radius: calc(var(--lw) * 0.012);\r\n  background: linear-gradient(170deg, #d3d6da, #c3c6cb 60%, #b8bbc1);\r\n  box-shadow:\r\n    inset 0 0 0 calc(var(--lw) * 0.0014) rgba(110, 114, 122, 0.55),\r\n    inset 0 calc(var(--lw) * 0.002) 0 rgba(255, 255, 255, 0.6);\r\n  transition: background 160ms ease-out, box-shadow 120ms ease-out;\r\n  touch-action: none;\r\n}\r\n.laptop[data-lid='open'] .lt-trackpad:hover {\r\n  background: linear-gradient(170deg, #dadde1, #cacdd2 60%, #bfc2c8);\r\n}\r\n.lt-trackpad.is-down {\r\n  box-shadow:\r\n    inset 0 0 0 calc(var(--lw) * 0.0014) rgba(90, 94, 102, 0.7),\r\n    inset 0 calc(var(--lw) * 0.003) calc(var(--lw) * 0.006) rgba(60, 64, 72, 0.35);\r\n}\r\n/* Display light falling on the deck; fades with the screen. */\r\n.lt-spill {\r\n  position: absolute;\r\n  inset: 0;\r\n  pointer-events: none;\r\n  background: radial-gradient(ellipse 70% 55% at 50% -8%, rgba(255, 226, 186, 0.34), transparent 70%);\r\n  opacity: 0;\r\n  transition: opacity 140ms ease-out;\r\n}\r\n\r\n/* ---------- Lid ---------- */\r\n.lt-lid {\r\n  left: 0;\r\n  bottom: 100%;\r\n  width: 100%;\r\n  height: 100%;\r\n  transform-style: preserve-3d;\r\n  transform-origin: 50% 100%;\r\n  transform: translateZ(calc(var(--foot) + var(--bt) + var(--lt) + var(--gap))) rotateX(calc(var(--phi) - 180deg));\r\n  transition: transform var(--lid-ms) cubic-bezier(0.55, 0.05, 0.25, 1);\r\n}\r\n.laptop[data-lid='closed'] .lt-lid {\r\n  transition-duration: 720ms;\r\n  transition-timing-function: cubic-bezier(0.5, 0, 0.35, 1);\r\n}\r\n.lt-lid {\r\n  pointer-events: none;\r\n}\r\n/* Hover/focus cue: the lid lifts a few degrees. */\r\n.laptop[data-lid='closed']:ha