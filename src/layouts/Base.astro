---
import '../styles/shelf.css';
import '../styles/board.css';
import '../styles/panels.css';
import '../styles/laptop.css';
import '../styles/studio.css';
import { site, REVIEW_MODE } from '../data/site';
import { serialize } from '../lib/seo/jsonld';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Open Graph type: `profile` on home and about, `website` elsewhere. */
  ogType?: 'website' | 'profile';
  /** A JSON-LD graph built from the page's own records (src/lib/seo/jsonld.ts). */
  jsonld?: Record<string, unknown> | null;
}
const { title = site.title, description = site.description, noindex = false, ogType = 'website', jsonld = null } = Astro.props;
const hidden = REVIEW_MODE || noindex || !site.indexable;
const robots = hidden ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ogImage = site.origin ? new URL('/og/the-shelf-preview.png', site.origin).href : null;
const canonical = site.origin ? new URL(Astro.url.pathname, site.origin).href : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#e2b083" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The Shelf" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="The Shelf — a personal archive by Ayush Jain." />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    {jsonld && !hidden && <script type="application/ld+json" set:html={serialize(jsonld)} />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#drawers">Skip to the drawers</a>
    {REVIEW_MODE && (
      <p class="review-banner" data-review-mode>Local review preview · not for publication · noindex</p>
    )}
    <slot />
  </body>
</html>
