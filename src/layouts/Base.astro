---
import '../styles/shelf.css';
import '../styles/panels.css';
import { site, REVIEW_MODE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = site.title, description = site.description, noindex = false } = Astro.props;
const robots = REVIEW_MODE || noindex ? 'noindex, nofollow' : 'index, follow';
const ogImage = site.origin ? new URL('/og/the-shelf-preview.png', site.origin).href : null;
const canonical = site.origin ? new URL(Astro.url.pathname, site.origin).href : null;
---
<!doctype html>
<html lang="en" data-lamp="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f5dfc4" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The Shelf" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content="The Shelf — a personal archive by Ayush Jain." />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (localStorage.getItem('shelf-lamp') === 'off') d.setAttribute('data-lamp', 'off');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#drawers">Skip to the drawers</a>
    {REVIEW_MODE && (
      <p class="review-banner" data-review-mode>Local review preview · not for publication · noindex</p>
    )}
    <slot />
  </body>
</html>
