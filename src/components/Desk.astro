---
import Laptop from './Laptop.astro';
import { slimLeaf, vine, type Vine } from './art';
import { site, featured } from '../data/site';

interface Props {
  active?: string | null;
}
const { active = null } = Astro.props;

// CodePen wvQYGay's three arching stems and slim petals, adapted to this
// physical desk and the existing finite, reduced-motion-safe sway.
const deskSprigs = [
  vine([96, 118], [57, 64], [39, 33], 5, 22, 44, 0.22),
  vine([101, 119], [93, 53], [106, 8], 7, 24, 42, 0.2),
  vine([104, 119], [147, 48], [177, 44], 6, 22, 46, 0.2),
  vine([96, 120], [57, 86], [6, 106], 5, 19, 45, 0.25),
  vine([108, 120], [130, 80], [148, 94], 5, 20, 46, 0.2),
];
const sprigMarkup = (sprig: Vine, index: number) => {
  const stem = `<path d="${sprig.d}" fill="none" stroke="#32472a" stroke-width="2.5" stroke-linecap="round"/>
    <path d="${sprig.d}" fill="none" stroke="#819558" stroke-opacity=".6" stroke-width=".65" stroke-linecap="round" transform="translate(-.6 -.5)"/>`;
  return stem + sprig.leaves.map((leaf, i) => {
    const shape = slimLeaf(leaf.s);
    const fill = (index + i) % 2 ? 'url(#leafA)' : 'url(#leafB)';
    const width = (0.87 + 0.12 * Math.sin(index * 2 + i * 1.7)).toFixed(2);
    return `<path d="M${leaf.px} ${leaf.py}L${leaf.x} ${leaf.y}" stroke="#5c743f" stroke-width="1.2" stroke-linecap="round"/>
      <g transform="translate(${leaf.x} ${leaf.y}) rotate(${leaf.a}) scale(${width} 1)" filter="url(#leafShadow)">
        <path d="${shape}" fill="${fill}" stroke="#324b2e" stroke-width=".65"/>
        <path d="M0 -2Q1 ${(-leaf.s * .52).toFixed(1)} 0 ${(-leaf.s * .84).toFixed(1)}" fill="none" stroke="#c5cf95" stroke-opacity=".45" stroke-width=".65"/>
      </g>`;
  }).join('');
};

// Sticky note: owner-supplied current items (D-12) or verified featured projects.
const noteItems = site.currentlyBuilding
  ? site.currentlyBuilding.map((t) => ({ label: t, href: null as string | null, slug: null as string | null }))
  : featured.slice(0, 3).map((p) => ({ label: p.title, href: `/projects/${p.slug}/`, slug: p.slug }));
const noteTitle = site.currentlyBuilding ? 'Currently Building:' : 'Pinned builds:';
---
<div class="g-note" hidden={noteItems.length === 0}>
  <div class="note">
    <span class="note__pin" aria-hidden="true"></span>
    <h2 class="note__title">{noteTitle}</h2>
    <ul class="note__list" role="list">
      {noteItems.map((n) => (
        <li>
          <span class="note__box" aria-hidden="true"></span>
          {n.href ? (
            <a href={n.href} data-nav="projects" data-record={n.slug}>{n.label}</a>
          ) : (
            <span>{n.label}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</div>

<div class="g-desk">
  <svg class="obj desk-plant" viewBox="0 0 186 176" aria-hidden="true" data-sway>
    <g class="sway sway--a">
      {deskSprigs.slice(0, 2).map((sprig, i) => <g><Fragment set:html={sprigMarkup(sprig, i)} /></g>)}
    </g>
    <g class="sway sway--b">
      {deskSprigs.slice(2).map((sprig, i) => <g><Fragment set:html={sprigMarkup(sprig, i + 2)} /></g>)}
    </g>
    <ellipse cx="100" cy="176" rx="46" ry="5" fill="#3a1d08" opacity=".4" />
    <ellipse cx="100" cy="172" rx="29" ry="5" fill="#6c5a42" />
    <path d="M68 124h64l-6 44q-1 6-7 6H81q-6 0-7-6z" fill="url(#pot)" stroke="#7c6a51" stroke-width="1.2" stroke-linejoin="round" />
    <path d="M68 124h64l-6 44q-1 6-7 6H81q-6 0-7-6z" fill="url(#ceramicSpeckle)" />
    <path d="M76 130l4 36" stroke="#fff" stroke-opacity=".5" stroke-width="3" stroke-linecap="round" />
    <path d="M63 116v8c0 8 74 8 74 0v-8" fill="url(#pot)" stroke="#8c795d" stroke-width="1.1" />
    <ellipse cx="100" cy="116" rx="37" ry="7" fill="url(#pot)" stroke="#e9dfcb" stroke-width="1.2" />
    <ellipse cx="100" cy="116" rx="33" ry="4" fill="#3a2210" />
    <ellipse cx="94" cy="115" rx="18" ry="2" fill="#5c3a1c" opacity=".8" />
  </svg>

  <!-- Closed leather notebook with an elastic band; it opens My Writings. -->
  <a class="obj notebook" href="/writing/" data-nav="writing" aria-label="Notebook: open My Writings" aria-current={active === 'writing' ? 'true' : undefined}>
    <span class="notebook__body" aria-hidden="true">
      <span class="notebook__band"></span>
      <span class="notebook__ribbon"></span>
    </span>
  </a>

  <Laptop open={active === 'laptop'} />

  <!-- The contact pen rests on the notebook. -->
  <a class="obj pen" href="/contact/" data-nav="contact" aria-label="Pen: write a message to Ayush" aria-current={active === 'contact' ? 'true' : undefined}>
    <svg viewBox="0 0 196 70" aria-hidden="true">
      <ellipse cx="100" cy="60" rx="84" ry="5" fill="#5a3a1c" opacity=".2" transform="rotate(14 100 60)" />
      <g transform="rotate(15 98 30)">
        <rect x="6" y="22" width="68" height="17" rx="8" fill="#1f1a17" stroke="var(--ink)" stroke-width="2" />
        <path d="M18 22v-4h34v4" fill="none" stroke="#c9963d" stroke-width="3" />
        <rect x="72" y="21" width="12" height="19" rx="2" fill="url(#brass)" stroke="var(--ink)" stroke-width="1.8" />
        <path d="M84 22h62l6 4v9l-6 4H84z" fill="#26201c" stroke="var(--ink)" stroke-width="2" />
        <rect x="150" y="24" width="10" height="13" rx="2" fill="url(#brass)" stroke="var(--ink)" stroke-width="1.6" />
        <path d="M160 25 190 30.5 160 36z" fill="url(#brass)" stroke="var(--ink)" stroke-width="1.8" stroke-linejoin="round" />
        <path d="M166 30.5h18" stroke="var(--ink)" stroke-width="1" />
        <path d="M14 26h52M92 25h48" stroke="#fff" stroke-opacity=".45" stroke-width="1.6" stroke-linecap="round" />
      </g>
    </svg>
  </a>

  <svg class="obj steam" viewBox="0 0 100 104" aria-hidden="true">
    <g fill="none" stroke-linecap="round">
      <path class="steam__w steam__w--1" d="M34 100C22 80 46 70 34 50S40 22 34 6" />
      <path class="steam__w steam__w--2" d="M54 100C44 84 64 72 54 54S60 30 56 14" />
      <path class="steam__w steam__w--3" d="M72 100C64 86 80 78 72 62S76 44 72 30" />
    </g>
  </svg>

  <!-- Original desk object, inspired by the reference's form; no model or thumbnail is reused. -->
  <svg class="obj speaker" viewBox="0 0 260 184" aria-hidden="true">
    <defs>
      <linearGradient id="speakerLeather" x1="0" y1="0" x2="1" y2=".85">
        <stop stop-color="#45413b" /><stop offset=".13" stop-color="#272927" />
        <stop offset=".64" stop-color="#1b1d1c" /><stop offset="1" stop-color="#0e1010" />
      </linearGradient>
      <linearGradient id="speakerSide" x1="0" y1="0" x2="1" y2=".4">
        <stop stop-color="#292a28" /><stop offset=".25" stop-color="#333230" />
        <stop offset=".68" stop-color="#202120" /><stop offset="1" stop-color="#121413" />
      </linearGradient>
      <linearGradient id="speakerGrille" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="#464a47" /><stop offset=".52" stop-color="#323734" /><stop offset="1" stop-color="#202522" />
      </linearGradient>
      <linearGradient id="speakerTrim" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="#a28b6b" /><stop offset=".18" stop-color="#6d5b45" />
        <stop offset=".76" stop-color="#5d4a39" /><stop offset="1" stop-color="#332b24" />
      </linearGradient>
      <radialGradient id="speakerFaceShade" cx=".4" cy=".3" r=".85">
        <stop stop-color="#d6d3c0" stop-opacity=".13" /><stop offset=".7" stop-color="#111715" stop-opacity="0" /><stop offset="1" stop-color="#050807" stop-opacity=".48" />
      </radialGradient>
      <pattern id="speakerWeave" width="7" height="6" patternUnits="userSpaceOnUse">
        <path d="M0 1.5h4M3.5 4.5H7" stroke="#aaa99b" stroke-opacity=".57" stroke-width="1.2" stroke-linecap="round" />
        <path d="M0 2.5h4M3.5 5.5H7" stroke="#0e1412" stroke-opacity=".82" stroke-width=".7" />
        <path d="M1 0v1M5 3v1" stroke="#66706a" stroke-opacity=".48" stroke-width=".6" />
      </pattern>
      <pattern id="speakerGrain" width="17" height="14" patternUnits="userSpaceOnUse">
        <circle cx="3" cy="4" r=".45" fill="#b9b1a0" opacity=".17" />
        <circle cx="11" cy="9" r=".4" fill="#8b8376" opacity=".13" />
        <path d="M5 11h2M13 2h1" stroke="#c6bca9" stroke-opacity=".1" stroke-width=".5" />
      </pattern>
      <clipPath id="speakerGrilleClip"><path d="M36 36Q87 32 206 39L210 144Q130 135 39 132Z" /></clipPath>
      <filter id="speakerContact" x="-25%" y="-100%" width="150%" height="300%"><feGaussianBlur stdDeviation="5" /></filter>
    </defs>
    <!-- The low contact shadow and two feet locate the cabinet on the desk. -->
    <ellipse cx="129" cy="173" rx="113" ry="8" fill="#201710" opacity=".39" filter="url(#speakerContact)" />
    <ellipse cx="132" cy="170" rx="92" ry="3.5" fill="#352418" opacity=".23" />
    <path d="M45 156h16v10q-8 4-15 0zM207 163h18v9q-9 4-16 0z" fill="#101211" />
    <path d="M48 164h11M210 170h14" stroke="#6b665d" stroke-width="1" opacity=".65" />
    <!-- Rounded upholstered shell, with its right side receding from the grille. -->
    <path d="M207 17Q242 17 248 30Q253 41 253 58L250 145Q249 166 220 169L205 150Z" fill="url(#speakerSide)" stroke="#171918" stroke-width="1.5" />
    <path d="M212 19Q241 21 245 38L244 145Q243 157 231 163" fill="none" stroke="#928e80" stroke-width="1.2" opacity=".23" />
    <path d="M29 18Q44 10 203 16Q221 17 226 32L228 149Q227 167 214 168Q126 154 35 153Q25 152 23 140L21 40Q20 23 29 18Z" fill="url(#speakerLeather)" stroke="#0d100f" stroke-width="1.7" />
    <path d="M29 18Q44 10 203 16Q221 17 226 32L228 149Q227 167 214 168Q126 154 35 153Q25 152 23 140L21 40Q20 23 29 18Z" fill="url(#speakerGrain)" />
    <path d="M31 22Q89 17 204 21" fill="none" stroke="#a8a293" stroke-width="1.3" opacity=".38" />
    <path d="M27 36Q26 23 33 21M25 46l2 85Q27 145 35 148" fill="none" stroke="#b0a99c" stroke-width="1" opacity=".23" />
    <!-- Fine woven speaker fabric sits inside the thick soft surround. -->
    <path d="M33 31Q90 25 211 34L215 149Q122 137 36 136Z" fill="#101412" stroke="#77756e" stroke-width="1" />
    <g clip-path="url(#speakerGrilleClip)">
      <path d="M33 33h180v115H33z" fill="url(#speakerGrille)" />
      <path d="M33 33h180v115H33z" fill="url(#speakerWeave)" />
      <path d="M33 33h180v115H33z" fill="url(#speakerFaceShade)" />
      <path d="M37 45Q42 90 39 128" fill="none" stroke="#f2edd6" stroke-width="1.4" opacity=".12" />
    </g>
    <path d="M36 134Q130 139 212 147L211 159Q120 146 37 146Z" fill="url(#speakerTrim)" stroke="#1b1b18" stroke-width="1" />
    <path d="M39 136Q122 141 208 148" fill="none" stroke="#d4bc91" opacity=".43" stroke-width=".8" />
    <path d="M40 143Q135 150 209 157" fill="none" stroke="#332a22" opacity=".54" stroke-width=".8" />
    <path d="M31 23Q28 26 28 36L30 138Q30 146 37 149M211 31Q222 32 222 43L223 148Q223 157 216 161" fill="none" stroke="#67665f" opacity=".34" stroke-width="2.3" />
    <!-- Four shallow metal controls are visible on top; they are decorative. -->
    {[80, 106, 132, 164].map((x, i) => (
      <g>
        <ellipse cx={x} cy={i === 3 ? 12 : 11} rx={i === 3 ? 4 : 8} ry="2.5" fill="#171818" />
        <path d={i === 3 ? `M${x-3} 10v-4q3-2 6 0v4` : `M${x-7} 10V6q7-3 14 0v4`} fill="url(#brass)" stroke="#302d27" stroke-width=".7" />
        <path d={`M${x-5} 6h10`} stroke="#f2dfb8" stroke-width=".7" opacity=".7" />
      </g>
    ))}
    <path d="M244 117l1 19" stroke="#65635a" stroke-width=".8" opacity=".55" />
    <rect x="242" y="125" width="3" height="9" rx="1.5" fill="#0e100f" />
  </svg>

  <svg class="obj mug" viewBox="0 0 146 134" aria-hidden="true" data-steam>
    <defs>
      <radialGradient id="coffeeSurface" cx=".4" cy=".22" r=".8"><stop stop-color="#886145" /><stop offset=".4" stop-color="#503623" /><stop offset="1" stop-color="#261c14" /></radialGradient>
      <linearGradient id="mugHandle" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff4df" /><stop offset=".4" stop-color="#e3d6bc" /><stop offset=".72" stop-color="#a49073" /><stop offset="1" stop-color="#e9dbc1" /></linearGradient>
    </defs>
    <ellipse cx="64" cy="124" rx="72" ry="14" fill="url(#cork)" stroke="#6b4422" stroke-width="2" />
    <ellipse cx="64" cy="122" rx="64" ry="10" fill="none" stroke="#a87a44" stroke-width="1" stroke-dasharray="2 3" />
    <ellipse cx="66" cy="124" rx="56" ry="6" fill="#3a1d08" opacity=".3" />
    <path d="M109 43c35-5 36 60 0 57" fill="none" stroke="#73614b" stroke-width="12" stroke-linecap="round" />
    <path d="M109 43c35-5 36 60 0 57" fill="none" stroke="url(#mugHandle)" stroke-width="9" stroke-linecap="round" />
    <path d="M116 45c18 1 22 29 11 43" fill="none" stroke="#fff9eb" stroke-width="1.5" stroke-linecap="round" opacity=".7" />
    <path d="M10 24l3 85q0 18 20 19h56q20-1 20-19l3-85" fill="url(#mug)" stroke="#89765d" stroke-width="1.4" stroke-linejoin="round" />
    <path d="M10 24l3 85q0 18 20 19h56q20-1 20-19l3-85" fill="url(#ceramicSpeckle)" />
    <path d="M19 39l2 67q1 9 7 11" fill="none" stroke="#fffaf0" stroke-width="3" stroke-linecap="round" opacity=".46" />
    <path d="M26 121q35 10 70-1" fill="none" stroke="#95836b" stroke-width="1.3" opacity=".6" />
    <ellipse cx="61" cy="24" rx="51" ry="11" fill="url(#mugHandle)" stroke="#97846b" stroke-width="1.2" />
    <ellipse cx="61" cy="24.5" rx="45" ry="8" fill="#847056" />
    <ellipse cx="61" cy="26" rx="43" ry="6.3" fill="url(#coffeeSurface)" />
    <path d="M21 25Q58 13 101 25" fill="none" stroke="#c3a579" stroke-width=".8" opacity=".7" />
    <path d="M30 24q13-3 22-2" fill="none" stroke="#e6ce9c" stroke-width="1.3" stroke-linecap="round" opacity=".46" />
    <path d="M12 25q49 20 98 0" fill="none" stroke="#fff9eb" stroke-width="2" />
    <g font-family="Georgia, 'Times New Roman', serif" font-weight="700" font-size="14.5" fill="var(--ink)" text-anchor="middle" letter-spacing=".6">
      <text x="60" y="62">MAKE •</text>
      <text x="60" y="81">LEARN •</text>
      <text x="60" y="100">REPEAT</text>
    </g>
  </svg>
</div>
