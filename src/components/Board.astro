---
// Wall board (desktop only): a weekly planner, a cork panel with the Pinned
// builds note, and stationery pockets in one aluminium frame. Everything on it
// is decoration except the note's links, which come from verified records.
import { site, featured } from '../data/site';

const plannerSamples = ['Sketch an idea', 'Build prototype', 'Write notes'];

// Owner-supplied current items (D-12) or verified featured projects.
const noteItems = site.currentlyBuilding
  ? site.currentlyBuilding.map((t) => ({ label: t, href: null as string | null, slug: null as string | null }))
  : featured.slice(0, 3).map((p) => ({ label: p.title, href: `/projects/${p.slug}/`, slug: p.slug }));
const noteTitle = site.currentlyBuilding ? 'Currently Building:' : 'Pinned Builds';

const papers = [
  { y: 112, tilt: -1.2, lines: 5 },
  { y: 184, tilt: 0.8, lines: 4 },
  { y: 256, tilt: -0.6, lines: 6 },
];
---
<div class="g-board">
  <div class="board">
    <div class="board__planner" aria-label="Weekly planner, editable demo" data-planner>
      <p class="planner__title">Weekly Planner</p>
      <svg class="planner__bulb" viewBox="0 0 48 56">
        <g fill="none" stroke="#2a1f16" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 36a13 13 0 1 1 16 0c-3 3-4 5-4 9h-8c0-4-1-6-4-9z" />
          <path d="M19 49h10M21 53h6M24 4V1M8 14 5 11M40 14l3-3M4 28H1M44 28h3" />
        </g>
      </svg>
      <p class="planner__hint">Sample tasks · saved on this device</p>
      <ul class="planner__tasks" role="list">
        {plannerSamples.map((task, i) => <li>
          <input type="checkbox" data-planner-done={i} aria-label={`Mark task ${i + 1} done`} />
          <input type="text" data-planner-text={i} aria-label={`Task ${i + 1}`} value={task} maxlength="48" />
        </li>)}
      </ul>
    </div>

    <div class="board__cork">
      <svg class="cork__art" viewBox="0 0 184 340" aria-hidden="true">
        <defs>
          <filter id="corkShadow" x="-25%" y="-25%" width="150%" height="160%"><feDropShadow dx="1.6" dy="3.2" stdDeviation="1.8" flood-color="#3b200a" flood-opacity=".42" /></filter>
          <radialGradient id="tack" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#f3d9a4" /><stop offset=".55" stop-color="#b98a45" /><stop offset="1" stop-color="#5e3d16" /></radialGradient>
          <linearGradient id="phoneCup" x1="0" x2="1"><stop offset="0" stop-color="#bdb9b2" /><stop offset=".35" stop-color="#f6f3ec" /><stop offset=".7" stop-color="#d9d5cc" /><stop offset="1" stop-color="#9d988f" /></linearGradient>
        </defs>

        <!-- sketch paper -->
        <g transform="translate(46 50) rotate(-4)" filter="url(#corkShadow)">
          <rect x="-34" y="-38" width="68" height="76" fill="#f8f1e3" stroke="#a89476" stroke-width=".8" />
          <g fill="none" stroke="#2a1f16" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(0 1) scale(.95)">
            <path d="M-10 -8a13 13 0 1 1 20 0c-3 3-4 6-4 10h-12c0-4-1-7-4-10z" />
            <path d="M-5 14h10M-4 18h8M-2 22h4M-3 8l2-12 1 5 2-5 1 12" />
            <path d="M0-30v-5M-17-22l-4-3M17-22l4-3M-23-8h-5M23-8h5" />
          </g>
          <circle cx="0" cy="-37" r="3.6" fill="url(#tack)" stroke="#3a260f" stroke-width=".8" />
        </g>

        <!-- landscape print (decorative drawing, not a record) -->
        <g transform="translate(131 54) rotate(5)" filter="url(#corkShadow)">
          <rect x="-35" y="-33" width="70" height="66" fill="#fbf6ec" stroke="#a89476" stroke-width=".8" />
          <rect x="-30" y="-28" width="60" height="45" fill="url(#dawnSky)" />
          <path d="M-30 -2-14-17 0-5 12-20 30 -4V17h-60z" fill="#7d86a8" />
          <path d="M-30 4-18-8-6 3 8-10 30 6V17h-60z" fill="#5d6b8e" />
          <path d="M-30 11C-10 6 8 13 30 8V17h-60z" fill="#6f8f3a" />
          <path d="M-6 17C-3 12 3 11 8 8 5 12 3 15 4 17z" fill="#a9c9d8" />
          <circle cx="0" cy="-32" r="3.6" fill="url(#tack)" stroke="#3a260f" stroke-width=".8" />
        </g>

        <!-- headphones hanging from a tack -->
        <g filter="url(#corkShadow)">
          <path d="M60 296C60 246 124 246 124 296" fill="none" stroke="#6b665e" stroke-width="10.5" stroke-linecap="round" />
          <path d="M60 296C60 246 124 246 124 296" fill="none" stroke="#efece5" stroke-width="7" stroke-linecap="round" />
          <path d="M66 282C70 258 88 252 98 253" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="1.6" stroke-linecap="round" />
          <rect x="50" y="286" width="20" height="44" rx="9" fill="url(#phoneCup)" stroke="#8d887e" stroke-width="1.1" />
          <rect x="114" y="286" width="20" height="44" rx="9" fill="url(#phoneCup)" stroke="#8d887e" stroke-width="1.1" />
          <rect x="68" y="293" width="8" height="30" rx="4" fill="#3b3732" />
          <rect x="108" y="293" width="8" height="30" rx="4" fill="#3b3732" />
          <path d="M55 292v30M119 292v30" stroke="#fff" stroke-opacity=".6" stroke-width="1.6" stroke-linecap="round" />
          <circle cx="92" cy="252" r="4.2" fill="url(#tack)" stroke="#3a260f" stroke-width=".8" />
        </g>
      </svg>

      <div class="note" hidden={noteItems.length === 0}>
        <span class="note__pin" aria-hidden="true"></span>
        <h2 class="note__title">{noteTitle}</h2>
        <ul class="note__list" role="list">
          {noteItems.map((n) => (
            <li>
              <span class="note__box" aria-hidden="true"></span>
              {n.href ? (
                <a href={n.href} data-nav="projects" data-record={n.slug}>{n.label}</a>
              ) : (
                <span>{n.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="board__pockets" aria-hidden="true">
      <svg viewBox="0 0 190 344">
        <defs>
          <pattern id="cupMesh" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M0 0l5 5M5 0 0 5" stroke="#5f6166" stroke-opacity=".5" stroke-width=".6" /></pattern>
          <filter id="pocketShadow" x="-10%" y="-20%" width="120%" height="150%"><feDropShadow dx="0" dy="2.5" stdDeviation="2" flood-color="#2c1a0c" flood-opacity=".4" /></filter>
        </defs>

        <!-- books standing on the top rail -->
        <g stroke="#2a1f16" stroke-width="1.2" stroke-linejoin="round">
          <path d="M98 108V22q0-4 4-4h16q4 0 4 4v86z" fill="#efe3c8" />
          <path d="M122 108V12q0-4 4-4h14q4 0 4 4v96z" fill="#2b2420" />
          <path d="M144 108V34q0-3 3-3h18q3 0 3 3v74z" fill="#b8793c" />
          <path d="M126 28h10M126 34h10M148 46h12M148 52h12" stroke="#d6ae5a" stroke-width="1" />
        </g>
        <path d="M168 108V40l8-2v70z" fill="#f4ecda" stroke="#2a1f16" stroke-width="1" />

        <!-- pen cup -->
        <g filter="url(#pocketShadow)">
          <g stroke-linecap="round">
            <path d="M32 60 24 14" stroke="#1d1a18" stroke-width="5" />
            <path d="M32 60 24 14" stroke="#c9963d" stroke-width="1.6" transform="translate(0 6)" />
            <path d="M44 60 46 10" stroke="#c9a24a" stroke-width="4.6" />
            <path d="M56 60 70 18" stroke="#6b4423" stroke-width="4.4" />
            <path d="M54 12l1-4" stroke="#d9a39a" stroke-width="4.6" transform="translate(14 8) rotate(8)" />
            <path d="M64 60 80 30" stroke="#d8d2c4" stroke-width="3.4" />
          </g>
          <path d="M18 56h60l-5 54q-1 5-6 5H29q-5 0-6-5z" fill="url(#alu)" stroke="#7c7f85" stroke-width="1.1" />
          <path d="M18 56h60l-5 54q-1 5-6 5H29q-5 0-6-5z" fill="url(#cupMesh)" />
          <ellipse cx="48" cy="56" rx="30" ry="5" fill="#cfd1d5" stroke="#7c7f85" stroke-width="1" />
          <path d="M26 62l3 46" stroke="#fff" stroke-opacity=".6" stroke-width="2" stroke-linecap="round" />
        </g>

        <!-- three pockets, each with paper behind a translucent aluminium front -->
        {papers.map((p, i) => (
          <g>
            <g transform={`rotate(${p.tilt} 95 ${p.y + 40})`} filter="url(#pocketShadow)">
              <rect x="18" y={p.y + 4} width="154" height="56" fill={i === 1 ? '#e9dcc0' : '#f6f1e6'} stroke="#b5a68a" stroke-width=".8" />
              <g stroke="#6d5a46" stroke-opacity=".55" stroke-width=".9" stroke-linecap="round" fill="none">
                {Array.from({ length: p.lines }, (_, k) => (
                  <path d={`M30 ${p.y + 12 + k * 8}h${70 + ((k * 37 + i * 23) % 60)}`} />
                ))}
                {i !== 1 && <path d={`M128 ${p.y + 12}l22 16-22 12z`} />}
              </g>
            </g>
            <path d={`M8 ${p.y + 28}h174v${40}q0 4-4 4H12q-4 0-4-4z`} fill="url(#alu)" fill-opacity=".94" stroke="#80838a" stroke-width="1.1" filter="url(#pocketShadow)" />
            <path d={`M10 ${p.y + 30}h170`} stroke="#fff" stroke-opacity=".75" stroke-width="1.4" />
            <path d={`M10 ${p.y + 66}h170`} stroke="#6c6f75" stroke-opacity=".4" stroke-width="1" />
          </g>
        ))}
      </svg>
    </div>

    <span class="board__gloss" aria-hidden="true"></span>
  </div>
</div>
