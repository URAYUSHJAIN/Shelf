---
// The board uses release-gated project records; review-only images stay in the
// loopback preview and never enter a production build.
import { site, featured } from '../data/site';

const plannerSamples = ['Sketch an idea', 'Build prototype', 'Write notes'];

const completedItems = featured.slice(0, 3);
const buildingItems = site.currentlyBuilding ?? [];
const initialMode = buildingItems.length > 0 ? 'building' : 'completed';
const photoProject = featured.find((p) => p.images.length > 0) ?? featured[0];
const photo = photoProject?.images[0];
const previewProjects = [...new Map([...completedItems, ...(photoProject ? [photoProject] : [])].map((p) => [p.slug, p])).values()];
---
<div class="g-board">
  <div class="board">
    <span class="board__cork" aria-hidden="true"></span>

    <!-- Weekly plan: an editable demo sheet. Its sample tasks are not portfolio facts. -->
    <div class="board__planner" aria-label="Weekly plan, editable demo" data-planner>
      <span class="pin" aria-hidden="true"></span>
      <p class="planner__title">Weekly Plan</p>
      <svg class="planner__bulb" viewBox="0 0 48 56" aria-hidden="true">
        <g fill="none" stroke="#2a1f16" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 36a13 13 0 1 1 16 0c-3 3-4 5-4 9h-8c0-4-1-6-4-9z" />
          <path d="M19 49h10M21 53h6M24 4V1M8 14 5 11M40 14l3-3M4 28H1M44 28h3" />
        </g>
      </svg>
      <ul class="planner__tasks" role="list">
        {plannerSamples.map((task, i) => <li>
          <input type="checkbox" data-planner-done={i} aria-label={`Mark task ${i + 1} done`} />
          <input type="text" data-planner-text={i} aria-label={`Task ${i + 1}`} value={task} maxlength="48" />
        </li>)}
      </ul>
      <p class="planner__hint">Sample tasks · saved on this device</p>
    </div>

    {photoProject && (
      <a class="board-polaroid" href={`/projects/${photoProject.slug}/`} data-board-preview={photoProject.slug} data-board-photo hidden={initialMode !== 'completed'}>
        <span class="board-polaroid__image">
          {photo ? <img src={photo.thumb?.src ?? photo.full.src} alt={photo.alt} loading="lazy" width={photo.thumb?.width ?? photo.full.width} height={photo.thumb?.height ?? photo.full.height} /> : <span class="board-polaroid__placeholder">Project file</span>}
        </span>
        <span class="board-polaroid__caption">{photoProject.title}</span>
      </a>
    )}

    <div class="note" data-board-note>
      <span class="note__pin" aria-hidden="true"></span>
      <h2 class="note__title" data-board-title>{initialMode === 'building' ? 'Currently Building' : 'Pinned Builds'}</h2>
      <ul class="note__list" role="list" data-board-list="completed" hidden={initialMode !== 'completed'}>
        {completedItems.map((project) => (
          <li>
            <a href={`/projects/${project.slug}/`} data-board-preview={project.slug}>{project.title}</a>
          </li>
        ))}
      </ul>
      <ul class="note__list" role="list" data-board-list="building" hidden={initialMode !== 'building' || buildingItems.length === 0}>
        {buildingItems.map((item) => <li><span>{item}</span></li>)}
      </ul>
      <p class="note__empty" data-board-empty hidden={initialMode === 'completed' || buildingItems.length > 0}>No verified current builds are public yet.</p>
    </div>

    <!-- Status selector: a small wooden switch plate with one lit indicator. -->
    <fieldset class="board-switch" data-board-switch data-mode={initialMode}>
      <legend class="sr-only">Pinboard view</legend>
      <label><input type="radio" name="board-mode" value="ideas" aria-label="Ideas" /><i aria-hidden="true"></i><span>Ideas</span></label>
      <label><input type="radio" name="board-mode" value="building" aria-label="Currently Building" checked={initialMode === 'building'} /><i aria-hidden="true"></i><span>Building</span></label>
      <label><input type="radio" name="board-mode" value="completed" aria-label="Completed prototypes" checked={initialMode === 'completed'} /><i aria-hidden="true"></i><span>Done</span></label>
    </fieldset>

    <!-- Headphones hang from a tack; the SVG is the no-WebGL fallback. -->
    <div class="obj board-phones" data-studio="headphones" aria-hidden="true">
      <svg viewBox="0 0 120 140">
        <path d="M24 96C24 22 96 22 96 96" fill="none" stroke="#2a1f18" stroke-width="9" stroke-linecap="round" />
        <path d="M24 96C24 22 96 22 96 96" fill="none" stroke="#6b4a2c" stroke-width="3" stroke-linecap="round" />
        <rect x="10" y="80" width="26" height="50" rx="11" fill="#2b2420" stroke="#b8935a" stroke-width="2" />
        <rect x="84" y="80" width="26" height="50" rx="11" fill="#2b2420" stroke="#b8935a" stroke-width="2" />
      </svg>
    </div>
    <span class="pin pin--phones" aria-hidden="true"></span>
  </div>
  <dialog class="board-preview" data-board-dialog aria-label="Project preview">
    <button type="button" class="board-preview__close" data-board-close aria-label="Close project preview">×</button>
    {previewProjects.map((project) => (
      <article data-board-detail={project.slug} hidden>
        <p class="board-preview__eyebrow">Project file</p>
        <h2>{project.title}</h2>
        <p>{project.summary}</p>
        {project.technologies && project.technologies.length > 0 && <p class="board-preview__stack"><strong>Tools</strong> · {project.technologies.slice(0, 5).join(' · ')}</p>}
        <div class="board-preview__links">
          <a href={`/projects/${project.slug}/`} data-nav="projects" data-record={project.slug}>Open project</a>
          {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer">Repository ↗</a>}
          {project.demo && <a href={project.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}
        </div>
      </article>
    ))}
  </dialog>
</div>
