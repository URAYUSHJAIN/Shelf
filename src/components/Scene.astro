---
import Icon from './Icon.astro';
import TopShelf from './TopShelf.astro';
import Cabinet from './Cabinet.astro';
import Desk from './Desk.astro';
import { slimLeaf, vine } from './art';
import { copy, chips, site, patents, REVIEW_MODE } from '../data/site';

interface Props {
  active?: string | null;
}
const { active = null } = Astro.props;

const wallLeft = [
  vine([-10, 30], [90, 60], [230, 40], 9, 30, 55, 0.3),
  vine([-10, 110], [60, 120], [120, 170], 5, 26, 55, 0.3),
  vine([40, -10], [70, 40], [60, 100], 4, 24, 50, 0.2),
];
const wallRight = [
  vine([1546, 20], [1460, 40], [1380, 22], 7, 28, 55, 0.3),
  vine([1546, 90], [1490, 100], [1450, 140], 4, 24, 55, 0.2),
];
const intro = REVIEW_MODE
  ? 'I build web applications and AI-assisted tools, and study Computer Science at ABES Engineering College.'
  : 'I build full-stack web applications and AI-assisted tools.';
---
<div class="stage" data-scene>
  <svg class="defs" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="bookDark" x1="0" x2="1"><stop offset="0" stop-color="#4a2c18" /><stop offset=".45" stop-color="#7a4b2a" /><stop offset="1" stop-color="#3d2414" /></linearGradient>
      <linearGradient id="bookCream" x1="0" x2="1"><stop offset="0" stop-color="#e2c9a2" /><stop offset=".4" stop-color="#f8ecd6" /><stop offset="1" stop-color="#d9bd93" /></linearGradient>
      <linearGradient id="brass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f0bf6e" /><stop offset=".45" stop-color="#b8742f" /><stop offset="1" stop-color="#7a4518" /></linearGradient>
      <linearGradient id="shade" x1="0" y1="0" x2=".3" y2="1"><stop offset="0" stop-color="#9a6130" /><stop offset=".5" stop-color="#6f3f1a" /><stop offset="1" stop-color="#4a2810" /></linearGradient>
      <radialGradient id="bulbHalo"><stop offset="0" stop-color="#fff3c0" stop-opacity=".95" /><stop offset=".5" stop-color="#ffd27a" stop-opacity=".45" /><stop offset="1" stop-color="#ffc35a" stop-opacity="0" /></radialGradient>
      <linearGradient id="leafA" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#5d9631" /><stop offset="1" stop-color="#a9d46c" /></linearGradient>
      <linearGradient id="leafB" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#4c8527" /><stop offset="1" stop-color="#93c45a" /></linearGradient>
      <linearGradient id="pot" x1="0" x2="1"><stop offset="0" stop-color="#e9dfcd" /><stop offset=".4" stop-color="#fdf9f1" /><stop offset="1" stop-color="#d8ccb6" /></linearGradient>
      <linearGradient id="mug" x1="0" x2="1"><stop offset="0" stop-color="#e8dcc6" /><stop offset=".35" stop-color="#fbf5ea" /><stop offset="1" stop-color="#ddcfb6" /></linearGradient>
      <linearGradient id="alu" x1="0" y1="0" x2=".2" y2="1"><stop offset="0" stop-color="#e6e7ea" /><stop offset=".6" stop-color="#cfd1d5" /><stop offset="1" stop-color="#b3b6bc" /></linearGradient>
      <linearGradient id="deskWood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f1dbb8" /><stop offset="1" stop-color="#e2c092" /></linearGradient>
    </defs>
  </svg>

  <svg class="wall-leaves" viewBox="0 0 1536 260" preserveAspectRatio="none" aria-hidden="true">
    {[...wallLeft, ...wallRight].map((v) => (
      <g>
        <path d={v.d} fill="none" stroke="#b08a66" stroke-width="2" />
        {v.leaves.map((l) => (
          <path d={slimLeaf(l.s * 1.3)} transform={`translate(${l.x} ${l.y}) rotate(${l.a})`} fill="#caa47f" stroke="#a37c58" stroke-width="1.2" />
        ))}
      </g>
    ))}
  </svg>
  <div class="wall-shadow" aria-hidden="true"></div>

  <svg class="desk-surface" viewBox="0 0 1536 284" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 14 1536 2V284H0Z" fill="url(#deskWood)" />
    <path d="M0 14 1536 2" stroke="#b98d5c" stroke-width="2.4" />
    <path d="M0 17 1536 5" stroke="#fff6e4" stroke-width="2" opacity=".7" />
    <g fill="none" stroke="#c99f6e" stroke-width="1.4" opacity=".55">
      <path d="M0 84C420 78 1100 64 1536 58" />
      <path d="M0 168C480 160 1080 148 1536 140" />
      <path d="M0 250C520 242 1060 232 1536 226" />
      <path d="M340 84 300 168M820 72 800 156M1240 64 1260 148M560 162 540 246M1020 152 1040 234" />
    </g>
    <g fill="none" stroke="#d2ad80" stroke-width="1" opacity=".5">
      <path d="M60 40c80-4 160 4 240 0M420 120c90-6 200 2 300-4M900 34c100-4 200 4 260-2M1100 200c80-4 180 2 300-6M140 210c90-4 160 2 240-4" />
    </g>
    <ellipse cx="766" cy="18" rx="470" ry="18" fill="#7a5530" opacity=".22" />
  </svg>

  <header class="g-intro">
    <h1 class="wordmark">
      <span>THE</span>
      <span>SHELF.</span>
      <svg class="sparkle" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2c1.6 10 7.4 16.4 18 18-10.6 1.6-16.4 8-18 18-1.6-10-7.4-16.4-18-18C12.6 18.4 18.4 12 20 2z" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" /></svg>
    </h1>
    <p class="byline">A personal archive by <strong>Ayush Jain.</strong></p>
    <hr class="rule" />
    <p class="role">{patents.length ? 'Developer & named inventor.' : `${copy.role}.`}</p>
    <p class="intro">{intro} <a class="intro__mail" href={`mailto:${site.email}`}>Email&nbsp;Ayush</a></p>
    {chips.length > 0 && (
      <ul class="chips" role="list" aria-label="Focus areas">
        {chips.map((c) => (
          <li>
            <a class="chip" href={c.href} data-nav={c.href.startsWith('/patents') ? 'patents' : 'projects'} data-group={c.href.split('group=')[1]}>
              <Icon name={c.icon} size={22} />
              <span>{c.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </header>

  <TopShelf active={active} />

  <div class="lamp-switch needs-js">
    <svg class="lamp-switch__rays" viewBox="0 0 40 24" aria-hidden="true"><path d="M8 20 4 10M20 18V4M32 20l4-10" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" /></svg>
    <span aria-hidden="true">OFF</span>
    <button type="button" class="switch" role="switch" aria-checked="true" aria-label="Desk lamp" data-lamp-switch>
      <span class="switch__knob"></span>
    </button>
    <span aria-hidden="true">ON</span>
  </div>

  <Cabinet active={active} />
  <Desk active={active} />

  <div class="lamp-glow" aria-hidden="true"></div>
  <div class="lamp-dim" aria-hidden="true"></div>
</div>
