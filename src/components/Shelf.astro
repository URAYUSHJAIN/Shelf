---
import Base from '../layouts/Base.astro';
import Scene from './Scene.astro';
import Panels from './Panels.astro';
import { site } from '../data/site';

interface Props {
  active?: string | null;
  record?: string | null;
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'profile';
  jsonld?: Record<string, unknown> | null;
}
const { active = null, record = null, title = site.title, description = site.description, noindex = false, ogType = 'website', jsonld = null } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} ogType={ogType} jsonld={jsonld}>
  <Fragment slot="head">
    <!-- The cabinet's walnut is the largest paint; fetch it with the stylesheet. -->
    <link rel="preload" as="image" href="/textures/walnut-dark.webp" type="image/webp" fetchpriority="high" />
    <link rel="preload" as="image" href="/textures/walnut.webp" type="image/webp" />
  </Fragment>
  <main class="shelf" data-active={active ?? ''} data-record={record ?? ''}>
    <Scene active={active} />
    <Panels active={active} record={record} />
  </main>
  <script>
    import '../scripts/shelf-controller';
    import '../scripts/desk-interactions';
    import '../scripts/board-interactions';
  </script>
</Base>
