---
import Base from '../layouts/Base.astro';
import Scene from './Scene.astro';
import Panels from './Panels.astro';
import { site } from '../data/site';

interface Props {
  active?: string | null;
  record?: string | null;
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { active = null, record = null, title = site.title, description = site.description, noindex = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <main class="shelf" data-active={active ?? ''} data-record={record ?? ''}>
    <Scene active={active} />
    <Panels active={active} record={record} />
  </main>
  <script>
    import '../scripts/shelf-controller';
    import '../scripts/desk-interactions';
    if (matchMedia('(min-width: 1000px) and (min-height: 560px)').matches) {
      const load = () => import('../scripts/scene3d').then(({ initScene3D }) => initScene3D()).catch(() => {
        const control = document.querySelector<HTMLButtonElement>('[data-scene-orbit]');
        if (control) { control.textContent = '3D unavailable'; control.setAttribute('aria-label', 'Three-dimensional overview is unavailable; the portfolio remains fully usable'); }
      });
      if ('requestIdleCallback' in window) window.requestIdleCallback(load);
      else window.setTimeout(load, 1000);
    }
  </script>
</Base>
