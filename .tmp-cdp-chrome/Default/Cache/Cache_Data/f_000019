r\n  }\r\n  .facts dd {\r\n    margin-bottom: 6px;\r\n  }\r\n}\r\n\r\n/* Experience */\r\n.timeline {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0 0 0 22px;\r\n  border-left: 2px solid var(--ink);\r\n}\r\n.timeline__item {\r\n  position: relative;\r\n  margin: 0 0 16px;\r\n  padding: 12px 14px;\r\n  border: 2px solid var(--ink);\r\n  border-radius: 10px;\r\n  background: #fffcf6;\r\n}\r\n.timeline__item::before {\r\n  content: '';\r\n  position: absolute;\r\n  left: -32px;\r\n  top: 18px;\r\n  width: 14px;\r\n  height: 14px;\r\n  border: 2px solid var(--ink);\r\n  border-radius: 50%;\r\n  background: #f1dfc3;\r\n}\r\n.timeline__title {\r\n  margin: 0 !important;\r\n  font: 700 17px/1.3 var(--serif) !important;\r\n}\r\n.timeline__title span {\r\n  font-weight: 400;\r\n}\r\n.timeline__meta {\r\n  font-size: 13px;\r\n  color: var(--ink-mute);\r\n}\r\n\r\n/* Cards (education, achievements) */\r\n.cards {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n.card {\r\n  padding: 14px 16px;\r\n  border: 2px solid var(--ink);\r\n  border-radius: 12px;\r\n  background: #fffcf6;\r\n}\r\n.card__title {\r\n  margin: 0 0 4px;\r\n  font: 700 18px/1.25 var(--serif);\r\n}\r\n.card__meta {\r\n  margin: 0 0 4px !important;\r\n  font-size: 14px;\r\n  color: var(--ink-mute);\r\n}\r\n\r\n/* Toolbox */\r\n.skill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-height: 38px;\r\n  padding: 4px 12px;\r\n  border: 2px solid var(--ink);\r\n  border-radius: 8px;\r\n  background: #fffaf1;\r\n  text-decoration: none;\r\n  font: 700 14px var(--sans);\r\n  transition: transform var(--t-fast) var(--ease-out);\r\n}\r\n.skill:hover,\r\n.skill:focus-visible {\r\n  transform: translateY(-2px);\r\n  background: #fff;\r\n}\r\n.skill__n {\r\n  min-width: 22px;\r\n  padding: 1px 6px;\r\n  border-radius: 999px;\r\n  background: var(--ink);\r\n  color: #fdf6ea;\r\n  font-size: 12px;\r\n  text-align: center;\r\n}\r\n\r\n/*