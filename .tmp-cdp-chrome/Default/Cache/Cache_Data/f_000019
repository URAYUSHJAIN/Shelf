ute);\r\n}\r\n.entry__sum {\r\n  font-size: 14.5px;\r\n}\r\n.entries--compact {\r\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\r\n}\r\n.album-empty {\r\n  display: grid;\r\n  justify-items: center;\r\n  gap: 8px;\r\n  padding: 28px 18px;\r\n  border: 2px dashed var(--line);\r\n  border-radius: 12px;\r\n  text-align: center;\r\n  color: var(--ink-soft);\r\n}\r\n\r\n/* Contact */\r\n.contact {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n.contact label {\r\n  display: grid;\r\n  gap: 4px;\r\n  font-weight: 700;\r\n  font-size: 15px;\r\n}\r\n.contact input,\r\n.contact textarea {\r\n  width: 100%;\r\n  padding: 10px 12px;\r\n  border: 2px solid var(--ink);\r\n  border-radius: 10px;\r\n  background: #fffdf8;\r\n  font: 16px/1.4 var(--sans);\r\n  color: var(--ink);\r\n}\r\n.contact textarea {\r\n  resize: vertical;\r\n}\r\n.contact-book__tabs {\r\n  display: flex;\r\n  gap: 4px;\r\n  overflow-x: auto;\r\n  padding: 0 0 8px;\r\n  margin-bottom: 12px;\r\n}\r\n.contact-book__tabs a {\r\n  flex: none;\r\n  min-height: 40px;\r\n  padding: 9px 12px;\r\n  border: 1.5px solid #806245;\r\n  border-radius: 7px 7px 2px 2px;\r\n  background: #ead7b4;\r\n  font: 700 14px var(--sans);\r\n  text-decoration: none;\r\n}\r\n.contact-book__tabs a[aria-current='page'] { background: #fffaf0; border-bottom-color: #fffaf0; }\r\n.contact-book__tabs a:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }\r\n.contact-book {\r\n  padding: 5px 12px 12px 20px;\r\n  border-left: 12px solid #593b27;\r\n  background: repeating-linear-gradient(0deg, #d8c7a5 0 1px, #f8efde 1px 3px);\r\n  box-shadow: 4px 6px 0 #af9976, 7px 10px 15px #4d311b50;\r\n  perspective: 1200px;\r\n}\r\n.contact-book__page {\r\n  position: relative;\r\n  min-height: 360px;\r\n  padding: 22px clamp(14px, 4vw, 35px) 32px;\r\n  border: 1px solid #ddc9a8;\r\n  border-radius: 2px 13px 13px 2px;\r\n  background:\r\n    linear-gradient(90deg, transparent 0 36px, #cf987d66 37px, transparent 38px),\r\n    repeating-linear-gradient(0deg, transparent 0 28px, #8caac041 29px, transparent 30px),\r\n    #fffaf0;\r\n  box-shadow: inset 12px 0 14px #6b482226, 4px 5px 9px #5a3b2150;\r\n  transform-origin: left center;\r\n}\r\n.contact-book__corner {\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 0;\r\n  width: 70px;\r\n  height: 46px;\r\n  padding: 24px 5px 3px 12px;\r\n  clip-path: polygon(100% 0, 100% 100%, 0 100%);\r\n  background: linear-gradient(135deg, #dfcfaf 48%, #ba9e76 50%, #f5e5c9 52%);\r\n  color: #4d3623;\r\n  font: 700 10px var(--sans);\r\n  text-decoration: none;\r\n  text-align: right;\r\n}\r\n.contact-book__corner:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; clip-path: none; }\r\n.contact-book__page h3 { font: 700 clamp(22px, 3vw, 29px) var(--serif); margin: 5px 0 15px; }\r\n.contact-book__page ul { line-height: 1.8; }\r\n.contact-book__eyebrow { font: 700 12px var(--sans); letter-spacing: .12em; text-transform: uppercase; color: #755d43; }\r\n.contact__preview { padding: 12px; border: 1px solid #bba889; border-radius: 6px; background: #f7edd9; }\r\n.contact__preview pre { max-height: 150px; overflow: auto; margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font: 14px/1.5 var(--sans); }\r\n.contact__writing { position: relative; display: block; }\r\n.contact__writing textarea { display: block; }\r\n.contact__mirror { position: absolute; top: 0; left: 0; visibility: hidden; pointer-events: none; }\r\n.contact__pen { position: absolute; top: 0; left: 0; width: 2px; height: 2px; pointer-events: none; transition: transform 70ms linear; z-index: 1; }\r\n.contact__pen::before { content: ''; position: absolute; left: 3px; bottom: 2px; width: 58px; height: 6px; border-radius: 5px; background: linear-gradient(#d5af6b, #2b2520 35% 75%, #a77a42); box-shadow: 2px 2px 3px #2c1a0c55; transform-origin: left bottom; transform: rotate(-35deg); }\r\n.contact__pen::after { content: ''; position: absolute; left: 0; top: 0; border-left: 8px solid #b59058; border-top: 3px solid transparent; border-bottom: 3px solid transparent; transform: rotate(-35deg); }\r\n@media (prefers-reduced-motion: reduce) { .contact__pen { transition: none; } }\r\n\r\n/* 404 */\r\n.notfound {\r\n  max-width: 560px;\r\n  margin: 18vh auto;\r\n  padding: 24px;\r\n  text-align: center;\r\n}\r\n.notfound h1 {\r\n  font-size: 34px;\r\n}\r\n\r\n/* A drawer is one assembly: recessed floor, wooden walls, paper, original front.\r\n   The shell clips the portion still inside the cabinet during the pull. */\r\n.drawer-slot {\r\n  position: relative;\r\n  min-width: 0;\r\n  height: calc(90 * var(--u));\r\n}\r\n.drawer-cavity {\r\n  position: absolute;\r\n  inset: 1px 0 -3px;\r\n  overflow: hidden;\r\n  border: 2px solid var(--ink);\r\n  border-radius: 7px;\r\n  background:\r\n    radial-gradient(ellipse 55% 70% at 50% 0%, rgba(255, 196, 110, 0.55), transparent 70%),\r\n    linear-gradient(#3a2210, #6e4320 55%, #a8743e);\r\n  box-shadow: inset 0 10px 16px #1e0f05, inset 12px 0 12px #3a210d, inset -12px 0 12px #3a210d;\r\n}\r\n.drawer-cavity::before,\r\n.drawer-cavity::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 12%;\r\n  bottom: 8%;\r\n  width: 7%;\r\n  border: 1px solid #b28752;\r\n  background: linear-gradient(90deg, #3a281c, #bd9664, #4e3321);\r\n}\r\n.drawer-cavity::before { left: 2%; transform: skewY(-24deg); }\r\n.drawer-cavity::after { right: 2%; transform: skewY(24deg); }\r\n.drawer-cavity span {\r\n  position: absolute;\r\n  inset: 9% 10% 20%;\r\n  border: 1px solid #6d4a2b;\r\n  box-shadow: 0 3px 8px #1f140a;\r\n}\r\n.panel.is-mounted {\r\n  --wall: 22px;\r\n  inset: auto;\r\n  display: block;\r\n  max-height: none;\r\n  perspective: 1400px;\r\n  perspective-origin: 50% 0;\r\n  pointer-events: none;\r\n}\r\n.is-mounted .drawer-assembly {\r\n  display: block;\r\n  position: relative;\r\n  width: 100%;\r\n  height: calc(var(--tray-depth) + var(--front-height));\r\n  transform-origin: 0 0;\r\n  transform-style: preserve-3d;\r\n}\r\n.is-mounted .drawer-bottom {\r\n  display: block;\r\n  position: absolute;\r\n  inset: 8px 5px calc(var(--front-height) - 4px);\r\n  border: 2px solid var(--ink-soft);\r\n  border-radius: 8px 8px 3px 3px;\r\n  background: repeating-linear-gradient(178deg, transparent 0 24px, #b9854b30 25px 26px), linear-gradient(#bd8d57, var(--wood-2) 12%, #f3dcba 78%, #cc9c64);\r\n  box-shadow: inset 0 12px 18px #4e2b1b80, inset 12px 0 15px #76502f66, inset -12px 0 15px #76502f66, 0 22px 28px #3b221952, 0 6px 5px #3b22194d;\r\n  transform: translateZ(-8px);\r\n}\r\n.is-mounted .drawer-wall {\r\n  display: block;\r\n  position: absolute;\r\n  border: 2px solid #684221;\r\n  background: repeating-linear-gradient(92deg, transparent 0 5px, #86512422 6px 7px), linear-gradient(90deg, #8d5a30, #e6bb83 45%, #f7ddad 65%, #b57b43);\r\n  box-shadow: inset 3px 0 0 #fff2d3a3, inset -3px 0 0 #67422366;\r\n  pointer-events: none;\r\n}\r\n.is-mounted .drawer-wall--left,\r\n.is-mounted .drawer-wall--right {\r\n  top: 0;\r\n  height: calc(var(--tray-depth) + 8px);\r\n  width: var(--wall);\r\n  transform: translateZ(7px);\r\n}\r\n.is-mounted .drawer-wall--left { left: 0; clip-path: polygon(70% 0, 100% 0, 100% 100%, 0 100%); }\r\n.is-mounted .drawer-wall--right { right: 0; clip-path: polygon(0 0, 30% 0, 100% 100%, 0 100%); }\r\n.is-mounted .drawer-wall--back {\r\n  top: 0;\r\n  left: 15px;\r\n  right: 15px;\r\n  height: 22px;\r\n  border-radius: 5px 5px 0 0;\r\n  background: linear-gradient(#ffe5b7 0 22%, #7e512d 27%, #c18b52);\r\n  transform: translateZ(2px);\r\n}\r\n.is-mounted .panel__sheet {\r\n  position: absolute;\r\n  inset: 25px 27px calc(var(--front-height) + 10px);\r\n  width: auto;\r\n  min-height: 0;\r\n  border: 1.5px solid #9b774f;\r\n  border-radius: 16px 16px 5px 5px;\r\n  background: linear-gradient(115deg, #fffaf0, #f9edda 85%, #ecd4b3);\r\n  box-shadow: 0 4px 6px #50331e38, inset 0 1px 0 #fffdf6;\r\n  overflow: hidden;\r\n  transform: translateZ(1px);\r\n  pointer-events: auto;\r\n}\r\n.is-mounted .panel__head {\r\n  flex: none;\r\n  gap: 7px;\r\n  padding: 5px 8px;\r\n  border: 0;\r\n  background: transparent;\r\n  box-shadow: none;\r\n}\r\n.is-mounted .panel__tab { display: none; }\r\n.is-mounted .panel__title { font-size: 23px; }\r\n.is-mounted .panel__titles { display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap; }\r\n.is-mounted .panel__meta { margin: 0; font-size: 13px; }\r\n.is-mounted .panel__close { order: -1; background: none; border: 0; border-radius: 8px; }\r\n.is-mounted .panel__close:hover { transform: translateX(-2px); }\r\n.is-mounted .panel__body { padding: 8px 14px 24px; min-height: 0; }\r\n.is-mounted .panel__review { font-size: 11px; line-height: 1.3; padding: 4px 14px; margin: 0; }\r\n.is-mounted .drawer-front-mount {\r\n  display: block;\r\n  position: absolute;\r\n  top: var(--tray-depth);\r\n  left: -3px;\r\n  right: -3px;\r\n  height: var(--front-height);\r\n  transform: translateZ(14px);\r\n  pointer-events: auto;\r\n}\r\n.is-mounted .drawer {\r\n  height: 100%;\r\n  transform: none;\r\n  border-radius: 5px 5px 13px 13px;\r\n  background: repeating-linear-gradient(178deg, transparent 0 9px, #b4804824 10px 11px), linear-gradient(#fff0d3 0 12%, #d8ae7a 14% 18%, #f2d8b2 20%, #e4bd8d 100%);\r\n  box-shadow: inset 0 3px 0 #fff4db, inset 0 -5px 0 #ae7844, 0 6px 0 #805332, 0 12px 12px #3e23174d;\r\n}\r\n.is-mounted .drawer__face { inset: 4px 44px 24px; gap: 8px; }\r\n.is-mounted .drawer__label { font-size: 15px; text-decoration: none; }\r\n.is-mounted .drawer__icon { width: 19px; height: 19px; }\r\n.is-mounted .drawer__arrow { width: 20px; height: 20px; top: 10px; right: 18px; transform: rotate(180deg); }\r\n.is-mounted .drawer__handle {\r\n  bottom: 10px;\r\n  width: 92px;\r\n  height: 13px;\r\n  margin-left: -46px;\r\n  border: 2px solid #49301a;\r\n  border-top: 0;\r\n  border-radius: 0 0 10px 10px;\r\n  background: linear-gradient(#c48b45, #f4cd83 45%, #a47135);\r\n  box-shadow: inset 