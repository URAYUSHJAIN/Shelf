  height: 14px;
  border: 2px solid var(--ink);
  border-radius: 50%;
  background: #f1dfc3;
}
.timeline__title {
  margin: 0 !important;
  font: 700 17px/1.3 var(--serif) !important;
}
.timeline__title span {
  font-weight: 400;
}
.timeline__meta {
  font-size: 13px;
  color: var(--ink-mute);
}

/* Cards (education, achievements) */
.cards {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}
.card {
  padding: 14px 16px;
  border: 2px solid var(--ink);
  border-radius: 12px;
  background: #fffcf6;
}
.card__title {
  margin: 0 0 4px;
  font: 700 18px/1.25 var(--serif);
}
.card__meta {
  margin: 0 0 4px !important;
  font-size: 14px;
  color: var(--ink-mute);
}

/* Toolbox */
.skill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 38px;
  padding: 4px 12px;
  border: 2px solid var(--ink);
  border-radius: 8px;
  background: #fffaf1;
  text-decoration: none;
  font: 700 14px var(--sans);
  transition: transform var(--t-fast) var(--ease-out);
}
.skill:hover,
.skill:focus-visible {
  transform: translateY(-2px);
  background: #fff;
}
.skill__n {
  min-width: 22px;
  padding: 1px 6px;
  border-radius: 999px;
  background: var(--ink);
  color: #fdf6ea;
  font-size: 12px;
  text-align: center;
}

/* Certifications */
.creds {
  list-style: none;
  margin: 12px 0 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
}
.cred {
  display: flex;
  gap: 12px;
  padding: 12px;
  border: 2px solid var(--ink);
  border-radius: 12px;
  background: #fffcf6;
}
.cred__art {
  display: grid;
  place-items: center;
  flex: none;
  width: 64px;
  height: 64px;
  border-radius: 10px;
  background: #f3e7d3;
  color: var(--ink-soft);
}
.cred__art img {
  width: 60px;
  height: 60px;
  object-fit: contain;
}
.cred__title {
  margin: 0 0 2px;
  font: 700 15.5px/1.3 var(--serif);
}

/* Open book */
.book__tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 0;
  border-bottom: 2px solid var(--ink);
}
.book__tabs button {
  min-height: 42px;
  padding: 6px 16px;
  border: 2px solid var(--ink);
  border-bottom: 0;
  border-radius: 10px 10px 0 0;
  background: #efe0c6;
  font: 700 15px var(--serif);
  cursor: pointer;
  margin-bottom: -2px;
}
.book__tabs button[aria-selected='true'] {
  background: #fffaf1;
  border-bottom: 2px solid #fffaf1;
}
html:not(.js) .book__tabs {
  display: none;
}
.book__page {
  padding: 4px 4px 0;
}
.js .book__page[hidden] {
  display: none;
}
.entries {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 10px;
}
.entry {
  display: grid;
  gap: 2px;
  padding: 12px 14px;
  border: 2px solid var(--ink);
  border-radius: 10px;
  background: #fffcf6;
  text-decoration: none;
  transition: transform var(--t-fast) var(--ease-out);
}
.entry:hover,
.entry:focus-visible {
  transform: translateX(3px);
}
.entry__title {
  font: 700 16.5px/1.3 var(--serif);
}
.entry__meta {
  font-size: 13px;
  color: var(--ink-mute);
}
.entry__sum {
  font-size: 14.5px;
}
.entries--compact {
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
}
.album-empty {
  display: grid;
  justify-items: center;
  gap: 8px;
  padding: 28px 18px;
  border: 2px dashed var(--line);
  border-radius: 12px;
  text-align: center;
  color: var(--ink-soft);
}

/* Contact */
.contact {
  display: grid;
  gap: 12px;
}
.contact label {
  display: grid;
  gap: 4px;
  font-weight: 700;
  font-size: 15px;
}
.contact input,
.contact textarea {
  width: 100%;
  padding: 10px 12px;
  border: 2px solid var(--ink);
  border-radius: 10px;
  background: #fffdf8;
  font: 16px/1.4 var(--sans);
  color: var(--ink);
}
.contact textarea {
  resize: vertical;
}
.contact-book__tabs {
  display: flex;
  gap: 4px;
  overflow-x: auto;
  padding: 0 0 8px;
  margin-bottom: 12px;
}
.contact-book__tabs a {
  flex: none;
  min-height: 40px;
  padding: 9px 12px;
  border: 1.5px solid #806245;
  border-radius: 7px 7px 2px 2px;
  background: #ead7b4;
  font: 700 14px var(--sans);
  text-decoration: none;
}
.contact-book__tabs a[aria-current='page'] { background: #fffaf0; border-bottom-color: #fffaf0; }
.contact-book__tabs a:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
.contact-book {
  padding: 5px 12px 12px 20px;
  border-left: 12px solid #593b27;
  background: repeating-linear-gradient(0deg, #d8c7a5 0 1px, #f8efde 1px 3px);
  box-shadow: 4px 6px 0 #af9976, 7px 10px 15px #4d311b50;
  perspective: 1200px;
}
.contact-book__page {
  position: relative;
  min-height: 360px;
  padding: 22px clamp(14px, 4vw, 35px) 32px;
  border: 1px solid #ddc9a8;
  border-radius: 2px 13px 13px 2px;
  background:
    linear-gradient(90deg, transparent 0 36px, #cf987d66 37px, transparent 38px),
    repeating-linear-gradient(0deg, transparent 0 28px, #8caac041 29px, transparent 30px),
    #fffaf0;
  box-shadow: inset 12px 0 14px #6b482226, 4px 5px 9px #5a3b2150;
  transform-origin: left center;
}
.contact-book__corner {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 70px;
  height: 46px;
  padding: 24px 5px 3px 12px;
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
  background: linear-gradient(135deg, #dfcfaf 48%, #ba9e76 50%, #f5e5c9 52%);
  color: #4d3623;
  font: 700 10px var(--sans);
  text-decoration: none;
  text-align: right;
}
.contact-book__corner:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; clip-path: none; }
.contact-book__page h3 { font: 700 clamp(22px, 3vw, 29px) var(--serif); margin: 5px 0 15px; }
.contact-book__page ul { line-height: 1.8; }
.contact-book__eyebrow { font: 700 12px var(--sans); letter-spacing: .12em; text-transform: uppercase; color: #755d43; }
.contact__preview { padding: 12px; border: 1px solid #bba889; border-radius: 6px; background: #f7edd9; }
.contact__preview pre { max-height: 150px; overflow: auto; margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font: 14px/1.5 var(--sans); }
.contact__writing { position: relative; display: block; }
.contact__writing textarea { display: block; }
.contact__mirror { position: absolute; top: 0; left: 0; visibility: hidden; pointer-events: none; }
.contact__pen { position: absolute; top: 0; left: 0; width: 2px; height: 2px; pointer-events: none; transition: transform 70ms linear; z-index: 1; }
.contact__pen::before { content: ''; position: absolute; left: 3px; bottom: 2px; width: 58px; height: 6px; border-radius: 5px; background: linear-gradient(#d5af6b, #2b2520 35% 75%, #a77a42); box-shadow: 2px 2px 3px #2c1a0c55; transform-origin: left bottom; transform: rotate(-35deg); }
.contact__pen::after { content: ''; position: absolute; left: 0; top: 0; border-left: 8px solid #b59058; border-top: 3px solid transparent; border-bottom: 3px solid transparent; transform: rotate(-35deg); }
@media (prefers-reduced-motion: reduce) { .contact__pen { transition: none; } }

/* 404 */
.notfound {
  max-width: 560px;
  margin: 18vh auto;
  padding: 24px;
  text-align: center;
}
.notfound h1 {
  font-size: 34px;
}

/* A drawer is one assembly: recessed floor, wooden walls, paper, original front.
   The shell clips the portion still inside the cabinet during the pull. */
.drawer-slot {
  position: relative;
  min-width: 0;
  height: calc(90 * var(--u));
}
.drawer-cavity {
  position: absolute;
  inset: 1px 0 -3px;
  overflow: hidden;
  border: 2px solid var(--ink);
  border-radius: 7px;
  background:
    radial-gradient(ellipse 55% 70% at 50% 0%, rgba(255, 196, 110, 0.55), transparent 70%),
    linear-gradient(#3a2210, #6e4320 55%, #a8743e);
  box-shadow: inset 0 10px 16px #1e0f05, inset 12px 0 12px #3a210d, inset -12px 0 12px #3a210d;
}
.drawer-cavity::before,
.drawer-cavity::after {
  content: '';
  position: absolute;
  top: 12%;
  bottom: 8%;
  width: 7%;
  border: 1px solid #b28752;
  background: linear-gradient(90deg, #3a281c, #bd9664, #4e3321);
}
.drawer-cavity::before { left: 2%; transform: skewY(-24deg); }
.drawer-cavity::after { right: 2%; transform: skewY(24deg); }
.drawer-cavity span {
  position: absolute;
  inset: 9% 10% 20%;
  border: 1px solid #6d4a2b;
  box-shadow: 0 3px 8px #1f140a;
}
.panel.is-mounted {
  --wall: 22px;
  inset: auto;
  display: block;
  max-height: none;
  perspective: 1400px;
  perspective-origin: 50% 0;
  pointer-events: none;
}
.is-mounted .drawer-assembly {
  display: block;
  position: relative;
  width: 100%;
  height: calc(var(--tray-depth) + var(--front-height));
  transform-origin: 0 0;
  transform-style: preserve-3d;
}
.is-mounted .drawer-bottom {
  display: block;
  position: absolute;
  inset: 8px 5px calc(var(--front-height) - 4px);
  border: 2px solid var(--ink-soft);
  border-radius: 8px 8px 3px 3px;
  background: repeating-linear-gradient(178deg, transparent 0 24px, #b9854b30 25px 26px), linear-gradient(#bd8d57, var(--wood-2) 12%, #f3dcba 78%, #cc9c64);
  box-shadow: inset 0 12px 18px #4e2b1b80, inset 12px 0 15px #76502f66, inset -12px 0 15px #76502f66, 0 22px 28px #3b221952, 0 6px 5px #3b22194d;
  transform: translateZ(-8px);
}
.is-mounted .drawer-wall {
  display: block;
  position: absolute;
  border: 2px solid #684221;
  background: repeating-linear-gradient(92deg, transparent 0 5px, #86512422 6px 7px), linear-gradient(90deg, #8d5a30, #e6bb83 45%, #f7ddad 65%, #b57b43);
  box-shadow: inset 3px 0 0 #fff2d3a3, inset -3px 0 0 #67422366;
  pointer-events: none;
}
.is-mounted .drawer-wall--left,
.is-mounted .drawer-wall--right {
  top: 0;
  height: calc(var(--tray-depth) + 8px);
  width: var(--wall);
  transform: translateZ(7px);
}
.is-mounted .drawer-wall--left { left: 0; clip-path: polygon(70% 0, 100% 0, 100% 100%, 0 100%); }
.is-mounted .drawer-wall--right { right: 0; clip-path: polygon(0 0, 30% 0, 100% 100%, 0 100%); }
.is-mounted .drawer-wall--back {
  top: 0;
  left: 15px;
  right: 15px;
  height: 22px;
  border-radius: 5px 5px 0 0;
  background: linear-gradient(#ffe5b7 0 22%, #7e512d 27%, #c18b52);
  transform: translateZ(2px);
}
.is-mounted .panel__sheet {
  position: absolute;
  inset: 25px 27px calc(var(--front-height) + 10px);
  width: auto;
  min-height: 0;
  border: 1.5px solid #9b774f;
  border-radius: 16px 16px 5px 5px;
  background: linear-gradient(115deg, #fffaf0, #f9edda 85%, #ecd4b3);
  box-shadow: 0 4px 6px #50331e38, inset 0 1px 0 #fffdf6;
  overflow: hidden;
  transform: translateZ(1px);
  pointer-events: auto;
}
.is-mounted .panel__head {
  flex: none;
  gap: 7px;
  padding: 5px 8px;
  border: 0;
  background: transparent;
  box-shadow: none;
}
.is-mounted .panel__tab { display: none; }
.is-mounted .panel__title { font-size: 23px; }
.is-mounted .panel__titles { display: flex; align-items: baseline; gap: 7px; flex-wrap: wrap; }
.is-mounted .panel__meta { margin: 0; font-size: 13px; }
.is-mounted .panel__close { order: -1; background: none; border: 0; border-radius: 8px; }
.is-mounted .panel__close:hover { transform: translateX(-2px); }
.is-mounted .panel__body { padding: 8px 14px 24px; min-height: 0; }
.is-mounted .panel__review { font-size: 11px; line-height: 1.3; padding: 4px 14px; margin: 0; }
.is-mounted .drawer-front-mount {
  display: block;
  position: absolute;
  top: var(--tray-depth);
  left: -3px;
  right: -3px;
  height: var(--front-height);
  transform: translateZ(14px);
  pointer-events: auto;
}
.is-mounted .drawer {
  height: 100%;
  transform: none;
  border-radius: 5px 5px 13px 13px;
  background: repeating-linear-gradient(178deg, transparent 0 9px, #b4804824 10px 11px), linear-gradient(#fff0d3 0 12%, #d8ae7a 14% 18%, #f2d8b2 20%, #e4bd8d 100%);
  box-shadow: inset 0 3px 0 #fff4db, inset 0 -5px 0 #ae7844, 0 6px 0 #805332, 0 12px 12px #3e23174d;
}
.is-mounted .drawer__face { inset: 4px 44px 24px; gap: 8px; }
.is-mounted .drawer__label { font-size: 15px; text-decoration: none; }
.is-mounted .drawer__icon { width: 19px; height: 19px; }
.is-mounted .drawer__arrow { width: 20px; height: 20px; top: 10px; right: 18px; transform: rotate(180deg); }
.is-mounted .drawer__handle {
  bottom: 10px;
  width: 92px;
  height: 13px;
  margin-left: -46px;
  border: 2px solid #49301a;
  border-top: 0;
  border-radius: 0 0 10px 10px;
  background: linear-gradient(#c48b45, #f4cd83 45%, #a47135);
  box-shadow: inset 0 -2px 0 #835323, 0 3px 2px #67432166;
}
.is-mounted .drawer__handle::before,
.is-mounted .drawer__handle::after { background: #d8b279; }
.is-mounted .folders { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 12px; }
.is-mounted .folder { padding: 8px 7px 10px; }
.is-mounted .folder__art { aspect-ratio: 2 / 1; }
.is-mounted .folder__title { overflow-wrap: anywhere; }
.is-mounted .filter { min-height: 40px; padding: 4px 11px; font-size: 13px; }
.is-mounted .toolbar { gap: 8px; margin-bottom: 8px; }
.is-mounted:not(.is-searching) .search { display: none; }
.is-mounted .filters { flex-wrap: nowrap; overflow-x: auto; padding: 3px 2px 6px; }
.is-mounted .filter { flex: none; }
.is-mounted [data-project-count] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
.is-mounted .status-line { font-size: 12px; margin: 0; }
@media (max-width: 599px) {
  .is-mounted .panel__sheet { left: 19px; right: 19px; }
  .is-mounted .panel__body { padding-inline: 10px; }
  .is-mounted .panel__title { font-size: 20px; }
  .is-mounted .panel__titles { gap: 3px; }
  .is-mounted .folders { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .is-mounted .filter { min-height: 44px; }
}
@media (max-width: 359px) {
  .is-mounted .folders { grid-template-columns: 1fr; }
}

/* Pulled-drawer construction pass */
.panel.is-mounted {
  --front-height-visual: max(var(--front-height), clamp(88px, 8vw, 108px));
  perspective: 1700px;
  perspective-origin: 50% 8%;
  overflow: visible;
  filter: drop-shadow(0 20px 22px rgba(48, 23, 5, 0.24));
}

.is-mounted .drawer-assembly {
  height: calc(var(--tray-depth) + var(--front-height-visual));
  transform-origin: 50% 0;
}

.is-mounted .drawer-bottom {
  inset: 10px 10px calc(var(--front-height-visual) - 5px);
  border: 2px solid #5b351b;
  border-radius: 12px 12px 5px 5px;
  background:
    repeating-linear-gradient(171deg, rgba(108, 60, 23, 0.14) 0 2px, transparent 2px 18px),
    linear-gradient(118deg, #9b6030 0%, #d5a064 22%, #f2d4a7 68%, #b8793d 100%);
  box-shadow:
    inset 0 14px 20px rgba(64, 31, 10, 0.52),
    inset 13px 0 16px rgba(85, 47, 20, 0.34),
    inset -13px 0 16px rgba(85, 47, 20, 0.34),
    0 20px 26px rgba(59, 30, 10, 0.28),
    0 5px 5px rgba(59, 30, 10, 0.34);
  transform: translateZ(-10px);
}

.is-mounted .drawer-wall {
  border-color: #5d351a;
  background:
    repeating-linear-gradient(93deg, rgba(86, 45, 16, 0.16) 0 2px, transparent 2px 13px),
    linear-gradient(90deg, #6f3e1c 0%, #b9793d 22%, #f0c384 58%, #b6763a 82%, #643616 100%);
  box-shadow:
    inset 4px 0 0 rgba(255, 233, 184, 0.62),
    inset -5px 0 0 rgba(79, 40, 15, 0.42),
    0 4px 8px rgba(55, 27, 8, 0.26);
}

.is-mounted .drawer-wall--left,
.is-mounted .drawer-wall--right {
  width: clamp(24px, 2.2vw, 36px);
  height: calc(var(--tray-depth) + 10px);
  transform: translateZ(9px);
}

.is-mounted .drawer-wall--left { clip-path: polygon(70% 0, 100% 0, 100% 100%, 0 100%); }
.is-mounted .drawer-wall--right { clip-path: polygon(0 0, 30% 0, 100% 100%, 0 100%); }

.is-mounted .drawer-wall--back {
  left: 16px;
  right: 16px;
  height: 28px;
  background:
    repeating-linear-gradient(168deg, rgba(56, 27, 8, 0.2) 0 2px, transparent 2px 14px),
    linear-gradient(#edbd78 0 18%, #78451f 28%, #a86631 100%);
  box-shadow: inset 0 6px 8px rgba(55, 26, 8, 0.38), 0 3px 6px rgba(46, 22, 6, 0.35);
}

.is-mounted .panel__sheet {
  inset: 31px 34px calc(var(--front-height-visual) + 12px);
  border: 2px solid #8b643d;
  border-radius: 18px 18px 8px 8px;
  background:
    repeating-linear-gradient(0deg, rgba(144, 103, 62, 0.045) 0 1px, transparent 1px 12px),
    linear-gradient(115deg, #fffaf0, #f9edda 85%, #ecd4b3);
  box-shadow:
    0 7px 12px rgba(75, 42, 17, 0.22),
    inset 0 2px 0 #fffdf6,
    inset 0 -10px 18px rgba(142, 96, 50, 0.08);
  transform: translateZ(2px);
}

.is-mounted .panel__head {
  position: relative;
  min-height: 52px;
  padding: 8px 14px 7px;
  border-bottom: 1px solid rgba(135, 94, 53, 0.4);
}

.is-mounted .panel__title {
  font-size: clamp(24px, 2.2vw, 34px);
  letter-spacing: -0.02em;
}

.is-mounted .panel__meta {
  font-size: 14px;
}

.is-mounted .panel__body {
  padding: 12px 18px 26px;
}

.is-mounted .drawer-front-mount {
  height: var(--front-height-visual);
  transform: translateZ(18px);
}

.is-mounted .drawer {
  border: 2px solid #563016;
  border-radius: 8px 8px 16px 16px;
  background:
    repeating-linear-gradient(166deg, rgba(103, 53, 18, 0.13) 0 2px, transparent 2px 16px),
    linear-gradient(180deg, #f4c888 0 9%, #ad682d 13%, #e3b171 18%, #b96f31 52%, #8d4e20 100%);
  box-shadow:
    inset 0 4px 0 rgba(255, 236, 186, 0.74),
    inset 0 -8px 0 rgba(92, 44, 15, 0.46),
    inset 0 0 0 7px rgba(230, 174, 104, 0.72),
    inset 0 0 0 9px rgba(111, 58, 23, 0.62),
    0 7px 0 #5f3216,
    0 18px 18px rgba(48, 22, 5, 0.38);
