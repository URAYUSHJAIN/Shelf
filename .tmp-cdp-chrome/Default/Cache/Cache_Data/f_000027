  display: grid;
  grid-template-columns: 1.08fr 1fr;
  gap: 3cqw;
  padding: 3.4cqw 3.2cqw 2.6cqw;
  min-height: 0;
}
.lt-hero {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.lt-title {
  margin: 0;
  width: fit-content;
  font: 700 2.1em/1.05 var(--serif);
  color: #fff6e6;
}
.lt-title:focus {
  outline: none;
}
.lt-title:focus-visible {
  outline: max(2px, 0.4cqw) solid #8fb0ff;
}
.lt-role {
  margin: 1.1cqw 0 0;
  font-size: 0.82em;
  letter-spacing: 0.03em;
  color: #e8b878;
}
.lt-text {
  margin: 1.2cqw 0 0;
  font-size: 0.86em;
  color: #d9cab4;
}
.lt-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1.1cqw;
  margin-top: 2.6cqw;
}
.lt-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6cqw;
  padding: 0.9cqw 1.7cqw;
  border: 1px solid rgba(255, 228, 190, 0.4);
  border-radius: 99px;
  font-size: 0.78em;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color 140ms ease-out;
}
.lt-btn .icon {
  width: 0.95em;
  height: 0.95em;
}
.lt-btn:hover {
  background: rgba(255, 232, 200, 0.14);
}
.lt-btn--solid {
  background: #f1dcb8;
  border-color: #f1dcb8;
  color: #23170d !important;
  font-weight: 700;
}
.lt-btn--solid:hover {
  background: #fff0d4;
}
.lt-console {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 2cqw;
  border: 1px solid rgba(255, 228, 190, 0.16);
  border-radius: 1.6cqw;
  background: rgba(255, 238, 214, 0.05);
}
.lt-label {
  font-size: 0.68em;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #c9b597;
}
.lt-field {
  display: flex;
  align-items: center;
  gap: 1cqw;
  margin-top: 1cqw;
  padding: 0.9cqw 1.3cqw;
  border: 1px solid rgba(255, 228, 190, 0.3);
  border-radius: 1cqw;
  background: rgba(0, 0, 0, 0.28);
  font-family: Consolas, 'SF Mono', Menlo, monospace;
}
.lt-field:focus-within,
.lt-field.is-typing {
  border-color: #e8b878;
  box-shadow: 0 0 0 0.3cqw rgba(232, 184, 120, 0.22);
}
.lt-prompt {
  color: #e8b878;
  font-weight: 700;
}
.lt-field input {
  flex: 1;
  min-width: 0;
  padding: 0;
  border: 0;
  background: none;
  font: inherit;
  font-size: 0.86em;
  caret-color: #e8b878;
}
.lt-field input:focus {
  outline: none;
}
.lt-field input::placeholder {
  color: rgba(243, 231, 212, 0.45);
}
.lt-results {
  list-style: none;
  margin: 1cqw 0 0;
  padding: 0;
  overflow: hidden;
}
.lt-results li {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1cqw;
  padding: 0.75cqw 1.1cqw;
  border-radius: 0.8cqw;
  cursor: pointer;
}
.lt-results li:hover {
  background: rgba(255, 232, 200, 0.08);
}
.lt-results li[aria-selected='true'] {
  background: rgba(232, 184, 120, 0.22);
  box-shadow: inset 0.35cqw 0 0 #e8b878;
}
.lt-opt__title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 0.82em;
}
.lt-opt__kind {
  flex: none;
  font-size: 0.62em;
  color: #c9b597;
}
.lt-empty,
.lt-hint {
  margin: 1.2cqw 0 0;
  font-size: 0.68em;
  color: #c9b597;
}
.lt-hint {
  margin-top: auto;
  padding-top: 1cqw;
}
.lt-hud {
  position: absolute;
  left: 50%;
  bottom: 6cqw;
  margin: 0;
  padding: 1cqw 2.2cqw;
  border-radius: 99px;
  background: rgba(20, 13, 7, 0.85);
  border: 1px solid rgba(255, 228, 190, 0.25);
  font-size: 0.75em;
  transform: translate(-50%, 1cqw);
  opacity: 0;
  pointer-events: none;
  transition: opacity 160ms ease-out, transform 160ms ease-out;
}
.lt-hud.is-shown {
  opacity: 1;
  transform: translate(-50%, 0);
}

/* ---------- Narrow screens: the open laptop lifts into a centred overlay ---------- */
@media (max-width: 999px), (max-height: 559px) {
  .g-desk:has(.laptop.is-open) {
    container-type: normal;
  }
  .laptop.is-open {
    position: fixed;
    inset: 0;
    z-index: 25;
    width: auto;
    height: auto;
    --lw: min(calc(100vw - 24px), calc((100svh - 96px) / 1.12), 680px);
    --view: 46deg;
    --open: 120deg;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: rgba(34, 21, 10, 0.62);
  }
  .laptop.is-open .lt-frame {
    position: relative;
    left: auto;
    bottom: auto;
    flex: none;
    margin-top: calc(var(--ld) * 0.6);
  }
  .laptop.is-open .laptop__close {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border: 2px solid var(--ink);
    border-radius: 99px;
    background: var(--card);
    font: 700 15px var(--sans);
    text-decoration: none;
  }
  .laptop.is-open .lt-shadow {
    opacity: 0.6;
  }
}
@media (max-width: 520px) {
  .laptop.is-open .lt-ui {
    font-size: 3.1cqw;
  }
  .laptop.is-open .lt-main {
    grid-template-columns: 1fr;
    gap: 2cqw;
    padding-top: 2.2cqw;
    overflow: auto;
  }
  .laptop.is-open .lt-text,
  .laptop.is-open .lt-hint {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lt-lid {
    transition: none !important;
  }
  .laptop[data-lid='open'] .lt-ui,
  .laptop[data-lid='open'] .lt-portfolio-screen,
  .laptop[data-lid='open'] .lt-spill {
    transition: opacity 120ms ease-out !important;
  }
}

@media (pointer: coarse) {
  .lt-portfolio-tools a,
  .lt-portfolio-tools button { min-height: 44px; }
}
