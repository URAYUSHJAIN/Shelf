}

.is-mounted .drawer__face {
  inset: 10px 58px 31px;
  gap: 12px;
}

.is-mounted .drawer__label {
  font-size: clamp(22px, 2vw, 32px);
  text-shadow: 0 1px 0 rgba(255, 236, 183, 0.72);
}

.is-mounted .drawer__icon {
  width: clamp(28px, 2.5vw, 38px);
  height: clamp(28px, 2.5vw, 38px);
}

.is-mounted .drawer__arrow {
  top: 50%;
  right: 26px;
  width: 24px;
  height: 24px;
  transform: translateY(-50%) rotate(180deg);
}

.is-mounted .drawer__handle {
  bottom: 9px;
  width: clamp(96px, 12vw, 148px);
  height: 17px;
  margin-left: calc(clamp(-74px, -6vw, -48px));
  border: 2px solid #49301a;
  border-top: 0;
  border-radius: 0 0 12px 12px;
  background: linear-gradient(#8f5c22, #f4ca72 42%, #b17429 70%, #6d3b17);
  box-shadow:
    inset 0 -3px 0 #6b3a18,
    0 4px 3px rgba(61, 30, 8, 0.42);
}

.is-mounted .drawer__handle::before,
.is-mounted .drawer__handle::after {
  width: 11px;
  height: 11px;
  top: -8px;
  background: linear-gradient(135deg, #f3ce82, #85501e);
}

@media (max-width: 599px) {
  .panel.is-mounted {
    --front-height-visual: max(var(--front-height), 86px);
  }

  .is-mounted .panel__sheet {
    inset: 28px 22px calc(var(--front-height-visual) + 10px);
