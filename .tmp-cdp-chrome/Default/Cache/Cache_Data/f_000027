  top: calc(var(--y) * var(--u) + var(--oy, 0px));
  width: calc(var(--w) * var(--u));
  height: calc(var(--h) * var(--u));
}
.obj > svg {
  width: 100%;
  height: 100%;
  overflow: visible;
