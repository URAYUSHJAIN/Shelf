.is-mounted .drawer::after {
  content: '';
  position: absolute;
  inset: 10px 12px 25px;
  border: 1px solid rgba(255, 232, 180, 0.46);
  border-radius: 5px 5px 10px 10px;
  box-shadow: inset 0 2px 3px rgba(255, 243, 205, 0.3);
